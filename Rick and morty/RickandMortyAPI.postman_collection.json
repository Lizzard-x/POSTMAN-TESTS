  "item": [
    {
      "name": "1.Obtener todos los Personajes",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "console.log(response.results[7]);\r",
              "\r",
              "pm.test(\"confirmar personaje\", function(){\r",
              "    pm.expect(pm.response.text()).to.include(\"Rick Sanchez\");\r",
              "});\r",
              "\r",
              "pm.test(\"El personaje con el id '8' coincide con el nombre: \", function(){\r",
              "    var jsonData = pm.response.json();\r",
              "    var idRick = jsonData.results.find(x => x.id == 8)\r",
              "    pm.expect(idRick.name).to.eql(\"Adjudicator Rick\");\r",
              "});\r",
              "\r",
              "pm.test(\"La lista de personajes no está vacía\", function () {\r",
              "    var response = pm.response.json();\r",
              "    pm.expect(response.info.count).to.be.greaterThan(0);\r",
              "    pm.expect(response.results.length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Codigo de estatus Ok 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{Url_BaseRM}}{{Personajes}}",
          "host": [
            "{{Url_BaseRM}}{{Personajes}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2.Listado de personajes por pagina",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const cStatus = response.results.map(results=> results.status);\r",
              "console.log(cStatus)\r",
              "console.log(response)\r",
              "const characterAlives = response.results.filter((results) => results.status === \"Alive\");\r",
              "console.log(characterAlives);\r",
              "const results =  characterAlives[0];\r",
              "console.log(results);\r",
              "\r",
              "pm.test('Comprobar personaje vivo', ()=> { \r",
              "    pm.expect(results.status).to.eql(\"Alive\")\r",
              " });\r",
              "    \r",
              "pm.test(\"Comprobar Personajes existentes dentro de la pagina\", function(){\r",
              "    pm.expect(pm.response.text()).to.include(\"Rick's Garage\");\r",
              "    pm.expect(pm.response.text()).to.include(\"Memory Squanchy\");\r",
              "    pm.expect(pm.response.text()).to.include(\"Memory Rick\");\r",
              "    pm.expect(pm.response.text()).to.include(\"Memory Geardude\");\r",
              "    pm.expect(pm.response.text()).to.include(\"Birdperson & Tammy's Child\");\r",
              "    pm.expect(pm.response.text()).to.include(\"Two Crows\");\r",
              "    pm.expect(pm.response.text()).to.include(\"Mr. Cookie President\");\r",
              "    pm.expect(pm.response.text()).to.include(\"Nick\");\r",
              "    pm.expect(pm.response.text()).to.include(\"Harold (Garbage Goober)\");\r",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
