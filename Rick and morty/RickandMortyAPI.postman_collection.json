    {
      "name": "3.Obtener un Personaje por iD",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "//const arr = [1,5,10];\r",
              "//const personaje = arr.find(item => item.name === \"Rick Sanchez\");\r",
              "//console.log(personaje);\r",
              "console.log(response);\r",
              "console.log(response.origin);\r",
              "\r",
              "pm.test(\"El personaje es Rick Sanchez\", () => {\r",
              "    pm.expect(response.name).to.eql(\"Rick Sanchez\");\r",
              "    pm.expect(response.id).to.eql(1);\r",
              "    pm.expect(response.origin.name).to.equal(\"Earth (C-137)\");\r",
              "});\r",
              "\r",
              "var schema = {\r",
              "    \"itemss\": {\r",
              "        \"type\": \"object\",\r",
              "        \"properties\":\r",
              "        {\r",
              "            \"id\":{\"type\":\"int\"},\r",
              "            \"name\":{\"type\":\"string\"},\r",
              "            \"status\":{\"type\":\"int\"},\r",
              "            \"species\":{\"type\":\"string\"},\r",
              "            \"type\":{\"type\":\"string\"},\r",
              "            \"gender\":{\"type\":\"string\"},\r",
              "            \"origin\":{\"type\":\"object\"},\r",
              "            \"location\":{\"type\":\"object\"},\r",
              "            \"image\":{\"type\":\"string\"},\r",
              "            \"episode\":{\"type\":\"string\"},\r",
              "            \"url\":{\"type\":\"string\"},\r",
              "            \"created\":{\"type\":\"string\"}\r",
              "        }\r",
              "    }\r",
              "};\r",
              "pm.test(\"esquma validado\", ()=>{\r",
              "    pm.response.to.have.jsonSchema(schema);\r",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{Url_BaseRM}}{{Personajes}}/1",
          "host": [
            "{{Url_BaseRM}}{{Personajes}}"
          ],
          "path": [
            "1"
          ]
        }
      },
