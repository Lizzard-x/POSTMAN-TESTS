    {
      "name": "Listar Libros (Camino Feliz)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Status 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta es un array no vacío\", () => {\r",
              "    const books = pm.response.json();\r",
              "    pm.expect(books).to.be.an(\"array\").that.is.not.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Estructura de cada libro es válida\", () => {\r",
              "    pm.response.json().forEach(book => {\r",
              "        pm.expect(book).to.have.all.keys(\"id\", \"name\", \"type\", \"available\");\r",
              "        pm.expect(book.id).to.be.a(\"number\");\r",
              "        pm.expect(book.name).to.be.a(\"string\");\r",
              "        pm.expect(book.type).to.be.oneOf([\"fiction\", \"non-fiction\"]);\r",
              "        pm.expect(book.available).to.be.a(\"boolean\");\r",
              "    });\r",
              "});\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}{{Books}}",
          "host": [
            "{{baseUrl}}{{Books}}"
          ]
        }
      },
      "response": []
    },
